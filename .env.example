# Discord (обязательно)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Если задан — команды регистрируются мгновенно только на этом сервере (для разработки).
# Пусто = глобальная регистрация (обновление до 1 часа).
DISCORD_DEV_GUILD_ID=

# Spotify (опционально — нужен только для импорта плейлистов/треков по ссылке spotify.com)
# Client Credentials Flow, создать приложение: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius (опционально — нужен только для команды /lyrics)
# https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# Пути к бинарникам (в Docker уже настроены, локально — если не в PATH)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Путь к файлу базы данных sqlite
DATABASE_PATH=./data/musicbot.db

# Поведение плеера
DEFAULT_VOLUME=100
IDLE_LEAVE_MINUTES=5
MAX_QUEUE_SIZE=500
LOG_LEVEL=info
