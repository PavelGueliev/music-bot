# Discord (обязательно)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Если задан — команды регистрируются мгновенно только на этом сервере (для разработки).
# Пусто = глобальная регистрация (обновление до 1 часа).
DISCORD_DEV_GUILD_ID=

# Spotify (опционально — нужен только для импорта плейлистов/треков по ссылке spotify.com)
# Client Credentials Flow, создать приложение: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius (опционально — нужен только для команды /lyrics)
# https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# Пути к бинарникам (в Docker уже настроены, локально — если не в PATH)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Опционально: cookies.txt (формат Netscape) от залогиненного YouTube-аккаунта.
# Нужен только для видео с возрастным ограничением, которые YouTube не отдаёт
# анонимно. Без него всё остальное работает как обычно.
# Как получить: расширение браузера "Get cookies.txt LOCALLY" на YouTube
# (залогинившись), экспортировать файл, положить на сервер и указать путь.
# ВАЖНО: это фактически ключ от сессии того аккаунта — храни файл с правами
# 600 и не клади в git.
YTDLP_COOKIES_FILE=

# Путь к файлу базы данных sqlite
DATABASE_PATH=./data/musicbot.db

# Поведение плеера
DEFAULT_VOLUME=100
IDLE_LEAVE_MINUTES=5
MAX_QUEUE_SIZE=500
LOG_LEVEL=info
